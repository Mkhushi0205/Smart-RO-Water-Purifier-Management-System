<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Admin Dashboard </title>
    
    <link rel="stylesheet" href="/css/admin-dashboard.css"/>
</head>
<body>
    <!-- header, navigation -->
    <%- include("partials/navbar") %>


        <main class="main-content">
            <section class="welcome">
                <h1>Welcome, <%= user.fullName %> 👋</h1>
                <p id="currentDate">Manage your business from one place</p>
            </section>

            <section class="cards">
                <div class="card">
                    <h2>520</h2>
                    <p>Total Customers</p>
                </div>

                <div class="card">
                    <h2>48</h2>
                    <p>Products</p>
                </div>

                <div class="card">
                    <h2>17</h2>
                    <p>Pending Services</p>
                </div>

                <div class="card">
                    <h2>₹2,35,000</h2>
                    <p>Monthly Revenue</p>
                </div>
            </section>

            <section class="actions">
                <h2>Quick Actions</h2>
                <div class="action-container">
                    <div class="action-card">
                        <h3>+ Add Customer</h3>
                        <button>Add</button>
                    </div>

                    <div class="action-card">
                        <h3>💧 Add Product</h3>
                        <button>Add</button>
                    </div>

                    <div class="action-card">
                        <h3>👨‍🔧 Assign Technician</h3>
                        <button>Assign</button>
                    </div>

                    <div class="action-card">
                        <h3>📊 Generate Report</h3>
                        <button>View</button>
                    </div>
                </div>
            </section>

            <section class="action-content">
                <h2>Recent Service Bookings</h2>
                <table>
                    <tr>
                        <th>Customer</th>
                        <th>Service</th>
                        <th>Technician</th>
                        <th>Status</th>
                    </tr>

                    <tr>
                        <td>Rahul Sharma</td>
                        <td>Filter Change</td>
                        <td>Amit</td>
                        <td>Pending</td>
                    </tr>

                    <tr>
                        <td>Priya Singh</td>
                        <td>Installation</td>
                        <td>Rohit</td>
                        <td>Complete</td>
                    </tr>

                </table>

            </section>

        </main>
        
    </div>

    <script src="/js/admin-dashboard.js"></script>
    
</body>
</html>