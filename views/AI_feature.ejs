<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Water Assistant | M/S Shanti Enterprises</title>
    <link rel="stylesheet" href="/css/AI_feature.css"/>
</head>
<body>
    <!-- header -->
    <header>
        <div class="logo">
            <img src="/images/logo/logo.png"  alt="image">

            <div class="logo-text">
                <h2>M/S Shanti Enterprises</h2>
                <p>Professional RO Installation, Repair & Annual Maintenance.</p>
            </div>
        </div>

        <a href="/" class="home-btn">Home</a>
    </header>

     <!-- AI hero -->
    <section class="ai-hero">
        <h1>🤖 AI  Water assistant</h1>

        <p>Ask anything about RO Water Purifiers.
            Our AI will help you instantly.
        </p>
    </section>

      <!-- chat section -->
    <section class="chat-container">

        <div class="chat-box">

            <div class="bot-message">
                    👋 Hello!
                I'm your AI Water Assistant.
                How can I help you today?
            </div>
        </div>

            <div class="user-message">

                <div class="chat-input">
                    <input type="text" id="userInput" placeholder="Ask about RO, Service, AMC, Filters...">

                    <button id="sendBtn">Send</button> 
                </div>
            </div>
    </section>

    <!-- Ai feature -->
    <section class="ai-features">
        <h2>What can AI help with?</h2>
        <div class="feature-grid">
            <div class="feature-card">
                <h3>💧 Product Recommendation</h3>
                <p>
                    Suggest the best RO purifier according to your family size,
                    water source and budget.
                </p>
            </div>

            <div class="feature-card">
                <h3>🔧 Troubleshooting</h3>
                <p>
                    Detect common purifier problems and suggest quick solutions.
                </p>
            </div>

            <div class="feature-card">
                <h3>📅 Service Reminder</h3>
                <p>
                    Reminds customers when it's time to replace filters or book service.
                </p>
            </div>

            <div class="feature-card">
                <h3>📍 Service Booking</h3>
                <p>
                    Book an RO technician directly through AI chat.
                </p>
            </div>

            <div class="feature-card">
                <h3>💰 price Inquiry</h3>
                <p>
                    Get instant prices of RO systems, spare parts and AMC plans.
                </p>
            </div>

            <div class="feature-card">
                <h3>📞 Customer Support</h3>
                <p>
                    24×7 automated support for all customer questions.
                </p>
            </div>
        </div>
    </section>

    <!-- popular question -->
    <section class="popular">
        <h2>Popular questions</h2>
        <div class="question-list">
            <button>Which RO is best for my home?</button>
            <button>When should I change my filter?</button>
            <button>Why is my purifier leaking?</button>
            <button>How much does RO service cost?</button>
            <button>Book a technician</button>
        </div>
    </section>

    <!-- footer -->
     <footer>
        <p>
            © 2026 S/O Shanti Enterprises | AI Water Assistant
        </p>
     </footer>

     <script src="/js/AI_feature.js"></script>
</body>
</html>