<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Technician Dashboard</title>
    <link rel="stylesheet" href="/css/technician-dashboard.css"/>
</head>
<body>
    <!-- Header -->
     <header class="dashboard-header">
        <div class="logo">
            <a href="/">
                <img src="/images/logo/logo.png" alt="image">
            </a>

            <div class="logo-text">
                <h2>M/S Shanti Enterprises</h2>
                <p>Professional RO Installation, Repair & Annual Maintenance.</p>
            </div>
        </div>

        <a href="/logout" class="logout-btn">Logout</a>
     </header>

     <!-- dashboard layout -->
      <div class="dashboard">

        <!-- sidebar -->

        <aside class="sidebar">
            <ul>
                <li><a href="#">Dashboard</a></li>
                <li><a href="#">Assigned jobs</a></li>
                <li><a href="#">today's Schedule</a></li>
                <li><a href="#">Complete Service</a></li>
                <li><a href="#">Update Status</a></li>
                <li><a href="#">Profile</a></li>
            </ul>
        </aside>

        <!-- main-content -->
        <main class="main-content">

            <!-- welcome -->

            <section class="welcome">
                <h1>Welcome, <%= user.fullName %> 👋</h1>
                <p id="currentDate">Manage your assigned RO service jobs efficiently.</p>
            </section>

            <!-- statistics -->
             <section class="cards">

                <div class="card">
                    <h2>8</h2>
                    <p>Assigned Jobs</p>
                </div>

                <div class="card">
                    <h2>5</h2>
                    <p>completed today</p>
                </div>

                <div class="card">
                    <h2>3</h2>
                    <p>Pending Services</p>
                </div>

                <div class="card">
                    <h2>4.9 ⭐</h2>
                    <p>Customer Rating</p>
                </div>
             </section>

             <!-- Quick Action -->
              <section class="action">

                    <h2>quick Actions</h2>

                    <div class="action-container">

                        <div class="action-card">
                            <h3>📋 View Jobs</h3>
                            <button>Open</button>
                        </div>

                        <div class="action-card">
                            <h3>🔧 Update service</h3>
                            <button>Update</button>
                        </div>

                        <div class="action-card">
                            <h3>📸 Upload photo</h3>
                            <button>Upload</button>
                        </div>

                        <div class="action-card">
                            <h3>☎ Contact Customer</h3>
                            <button>Call</button>
                        </div>

                    </div>

              </section>

              <!-- Today's Jobs -->
               <section class="table-section">
                
                <h2>Today's Assigned Jobs</h2>

                    <table>
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Address</th>
                                <th>service</th>
                                <th>Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>Rahul Sharma</td>
                                <td>Jhansi</td>
                                <td>Filter Replacement</td>
                                <td>10:00 AM</td>
                                <td class="pending">Pending</td>
                            </tr>

                            <tr>
                                <td>Priya Singh</td>
                                <td>Sipri</td>
                                <td>RO Installation</td>
                                <td>2:00 PM</td>
                                <td class="completed">Completed</td>
                            </tr>

                            <tr>
                                <td>Amit Verma</td>
                                <td>Medical College Road</td>
                                <td>General Service</td>
                                <td>5:00 PM</td>
                                <td class="progress">In Progress</td>
                            </tr>
                            
                        </tbody>

                    </table>

               </section>

            </main>
            
        </div>

        <script src="/js/technician-dashboard.js"></script>
</body>
</html>