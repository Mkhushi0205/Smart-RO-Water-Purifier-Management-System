<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Services</title>

    <!-- font awesome -->
    <link rel="stylesheet" 
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"/>

    <!-- css -->
    <link rel="stylesheet" href="/css/services.css"/>
</head>
<body>

    <!-- header, navbar -->
     <%- include("partials/navbar") %>

    <!-- hero section -->
     <section class="services-hero">

        <div class="hero-overlay"></div>

        <div class="hero-content">
            <h1>
                Professional RO Water Purifier Services
            </h1>
            <p>
                We provide complete RO installatioon, repair, maintenance and AMC solutions for homes, offices, schools and industries.
            </p>

            <div class="hero-buttons">
                <a href="#book-service" class="btn-primary">
                    <i class="fa-solid fa-calendar-check"></i>
                    Book Service
                </a>

                <a href="tel: +91 9889086665" class="btn-secondary">
                    <i class="fa-solid fa-phone"></i>
                    Call Now
                </a>

            </div>

        </div>

    </section>
    
    <!-- our services -->
    <section class="services-section">

        <div class="container">

            <div class="section-title">

                <h2>Our RO services</h2>

                <p>
                    Reliable water purifier services delivered by certified technicians using genuine spare parts.
                </p>

            </div>

            <div class="services-grid">
                <!-- card-1 -->

                <div class="service-card">

                    <div class="icon">

                        <i class="fa-solid fa-screwdriver-wrench"></i>
                    </div>

                    <h3>RO Installation</h3>

                    <p>
                        Professional installation of  domestic and commercial RO water purifiers.
                    </p>

                    <ul>
                        <li>Domestic RO</li>
                        <li>Commercial RO</li>
                        <li>Wall Mount</li>
                        <li>Free Inspection</li>
                    </ul>

                    <a href="#book-service" class="service-btn">
                        Book Now
                    </a>

                </div>

                 <!-- card-2 -->
                <div class="service-card">

                    <div class="icon">
                        <i class="fa-solid fa-toolbox"></i>
                    </div>

                    <h3>RO Repair</h3>

                    <p>fast repair services for all leading RO water purifier brands.</p>

                    <ul>
                        <li>Leakage Repair</li>
                        <li>Pump Repair</li>
                        <li>Motor Service</li>
                        <li>Eletrical Fault</li>
                    </ul>

                    <a href="#book-service" class="service-btn">
                        Book Now
                    </a>

                </div>

                <!-- card-3 -->
                <div class="service-card">

                    <div class="icon">
                        <i class="fa-solid fa-filter"></i>
                    </div>

                    <h3>Filter Replacement</h3>

                    <p>Genuine RO filters and membranes for improved water quality.</p>

                    <ul>
                        <li>Sediment Filter</li>
                        <li>Carbon Filter</li>
                        <li>RO Membrane</li>
                        <li>UV Lamp</li>
                    </ul>

                    <a href="#book-service" class="service-btn">
                        Replace Now
                    </a>
                </div>

                <!-- card-4 -->
                <div class="service-card">

                    <div class="icon">
                        <i class="fa-solid fa-shield-heart"></i>
                    </div>

                    <h3>AMC Maintenance</h3>

                    <p>affordable annual maintenance plans with scheduled servicing.</p>

                    <ul>
                        <li>Regular Service</li>
                        <li>Health Check</li>
                        <li>Cleaning</li>
                        <li>Priority Support</li>
                    </ul>

                    <a href="#amc" class="service-btn">
                        View Plans
                    </a>

                </div>

                <!-- card-5 -->
                <div class="service-card">

                    <div class="icon">
                        <i class="fa-solid fa-industry"></i>
                    </div>

                    <h3>Commercial RO Plant</h3>

                    <p>Completed RO plant solutions for industries and institutions.</p>

                    <ul>
                        <li>Hotels</li>
                        <li>Hospitals</li>
                        <li>Schools</li>
                        <li>factories</li>
                    </ul>

                    <a href="/contact" class="service-btn">
                        Get Quote
                    </a>

                </div>

                <!-- card-6 -->
                <div class="service-card">

                    <div class="icon">
                        <i class="fa-solid fa-droplet"></i>
                    </div>

                    <h3>water Software Service</h3>

                    <p>Complete maintenane and servicing for hard water treatment systems.</p>

                    <ul>
                        <li>Software Installation</li>
                        <li>Salt Replacement</li>
                        <li>Maintenance</li>
                        <li>Inspection</li>
                    </ul>

                    <a href="#book-service" class="service-btn">
                        Book Now
                    </a>

                </div>
                
            </div>

        </div>

    </section>


    <!-- // <nav>
    //     <ul>
    //         <li><a href="#services">Services</a></li>
    //     </ul>
    // </nav> -->

    <script src="/js/main.js"></script>
    <script src="/js/services.js"></script>
</body>
</html>