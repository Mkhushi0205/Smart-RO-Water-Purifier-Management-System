<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Customer Dashboard </title>

    <link rel="stylesheet" href="/css/customer-dashboard.css">
</head>
<body>
        <header class="dashboard-header">
            <div class="logo">
                <a href="/">
                    <img src="/images/logo/logo.png" alt="image">
                </a>
            <div class="logo-text">
                <h2>M/S Shanti Enterprises</h2>
                <p>Professional RO Installation, Repair & Annual Maintenance.</p>
            </div>
        </div>

            <a href="/logout" class="logout-btn">Logout</a>
        </header>

        <div class="dashboard-nav">
            <aside class="sidebar">
                <ul>
                    <li><a href="/customer-dashboard">Dashboard</a></li>
                    <li><a href="/my-machines">My RO</a></li>
                    <li><a href="/services">Book Service</a></li>
                    <li><a href="/service-history">Service History</a></li>
                    <li><a href="#">Profile</a></li>
                </ul>
            </aside>
        

        <main class="main-content">

        <section class="welcome">
            <h1>Welcome, <%= user.fullName %> 👋</h1>
            <p>Manage your RO water purifier services easily.</p>
        </section>

        <section class="cards">
            <div class="card">
                <h3>2</h3>
                <p>Total RO Machines</p>
            </div>

            <div class="card">
                <h3>1</h3>
                <p>Pending Service</p>
            </div>

            <div class="card">
                <h3>5</h3>
                <p>Complete Services</p>
            </div>

            <div class="card">
                <h3>10 July 2026</h3>
                <p>Next Service</p>
            </div>
        </section>

        <section class="actions">

            <h2>Quick Actions</h2>

                <div class="action-container">

                    <div class="action-card">
                        <div class="icon">📅</div>
                        <h3>Book Service</h3>
                        <p>
                            Schedule a new RO service or request maintenance.
                        </p>
                        <a 
                            href="/service-history"
                            class="action-btn">
                            Book Now
                        </a>
                    </div>

                    <div class="action-card">
                        <div class="icon">🔧</div>
                        <h3>Replace Filter</h3>
                        <p>Request a filter or membrane replacement quickly.</p>
                        <button>Replace</button>
                    </div>

                    <div class="action-card">
                        <div class="icon">📞</div>
                        <h3>Contact Support</h3>
                        <p>Need help? Contact our support team anytime.</p>
                        <button>Call Now</button>
                    </div>

                </div>    
        </section>

        <table>
            <tr>
                <th>Date</th>
                <th>Service</th>
                <th>Status</th>
            </tr>

            <tr>
                <td>12 Jan 2026</td>
                <td>Filter Change</td>
                <td>Completed</td>
            </tr>

            <tr>
                <td>25 June 2026</td>
                <td>General Service</td>
                <td>Pending</td>
            </tr>
        </table>

        </main>
    </div>
    <script src="/js/customer-dashboard.js"></script>
</body>

</html>